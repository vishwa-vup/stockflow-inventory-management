# Copy to .env before starting the backend:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)

PROJECT_NAME="StockFlow — Inventory & Stock Management System"
API_V1_STR="/api"

# Change this to a long random string before any real deployment.
SECRET_KEY="stockflow-super-secret-key-college-demo-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Relative paths resolve from the backend/ directory.
DATABASE_URL="sqlite:///./stockflow.db"
